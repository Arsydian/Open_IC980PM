{
  "name": "open-ic980pm",
  "version": "1.1.0",
  "description": "Cross-Platform Radio Programming Studio for the HIROYASU IC-980 Pro Max (Windows, macOS, Linux; desktop app and WebHID web app)",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:compile": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json",
    "electron:dev": "npm run build && npm run electron:compile && electron .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ham-radio",
    "hiroyasu",
    "ic-980-pro-max",
    "cps",
    "chirp",
    "repeaterbook",
    "webhid",
    "electron"
  ],
  "author": "Open_IC980PM Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arsydian/Open_IC980PM.git"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
